{
    "name": "agentsoftware/laravel-property-bag",
    "description": "Easy Laravel user settings using a property bag",
    "type": "library",
    "keywords": ["laravel", "user", "settings", "property", "user settings", "property bag"],
    "homepage": "https://github.com/AgentSoftware/laravel-property-bag",
    "license": "MIT",
    "authors": [
        {
            "name": "Zach Leigh",
            "email": "zachleigh@fastmail.jp"
        },
        {
            "name": "AgentSoftware",
            "homepage": "https://agentsoftware.net"
        }
    ],
    "support": {
        "issues": "https://github.com/AgentSoftware/laravel-property-bag/issues",
        "source": "https://github.com/AgentSoftware/laravel-property-bag"
    },

    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0||^13.0",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/container": "^12.0||^13.0"
    },

    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-strict-rules": "^2"
    },

    "suggest": {
        "ext-pcov": "Enables fast code-coverage generation (composer test:coverage). Not required to install/run the suite; use the Dockerfile/compose.yaml dev harness if it's unavailable on your host."
    },

    "autoload": {
        "psr-4": {
            "LaravelPropertyBag\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "LaravelPropertyBag\\tests\\": "tests/"
        }
    },

    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "test:coverage-html": "phpunit --coverage-html build/coverage",
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=-1",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "test:coverage": "Run the test suite with a text coverage report.",
        "test:coverage-html": "Run the test suite with an HTML coverage report in build/coverage.",
        "lint": "Check code style with Pint, without fixing.",
        "lint:fix": "Fix code style violations with Pint.",
        "analyse": "Run PHPStan static analysis at level max.",
        "check": "Run the full local quality gate: lint, analyse, then test."
    },

    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra":{
        "laravel":{
            "providers":[
                "LaravelPropertyBag\\ServiceProvider"
            ]
        }
    }
}
